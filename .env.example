# Copy to .env.local (git-ignored) and fill in. Read by src/lib/env.ts.
# For the local stack, `npm run env:local` writes the three Supabase keys below
# into .env.local from `supabase status` (other lines are kept).

# Supabase API URL (required). Local stack: npm run db:start (ports in README).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
# Supabase anon (public) key (required). Locally, copy the publishable key
# (sb_publishable_...) printed by `npx supabase status`; this variable holds it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Supabase service role key (server only, never expose to the browser). Optional for
# `next build`, required at runtime for sign-in rate limiting and admin:create-user.
# Locally, the secret key (sb_secret_...) from `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile on /sign-up (Story 10.1). Leave both empty locally and in CI: no
# widget, no check. Production must set both. Cloudflare's always-pass test keys for a
# local try: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Outgoing mail the app sends itself (Story 10.4: the "You're in" email). Optional: without
# SMTP_HOST, EMAIL_FROM and APP_URL the app sends no mail (accounts are still activated).
# Production: the same SMTP provider as Supabase Auth, and the site's public URL.
# Local stack (Mailpit; `npm run env:local` writes these four):
#   SMTP_HOST=127.0.0.1  SMTP_PORT=56325  EMAIL_FROM=Plan Markup <no-reply@plan-markup.test>
#   APP_URL=http://localhost:3020
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
APP_URL=
# Sentry DSN (optional). Leave empty locally and in CI: Sentry stays off
# (never initialised, no network calls).
NEXT_PUBLIC_SENTRY_DSN=
# Sentry environment name (optional; defaults to production/development from NODE_ENV).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Sentry auth token (optional, build only). Without it no source maps are uploaded.
SENTRY_AUTH_TOKEN=
# Sentry organisation and project slugs (optional, build only, used with SENTRY_AUTH_TOKEN).
SENTRY_ORG=
SENTRY_PROJECT=
# Log level: debug | info | warn | error (optional; default info in production, debug otherwise).
NEXT_PUBLIC_LOG_LEVEL=
