# Copy to .env.local (git-ignored) and fill in. Read by src/lib/env.ts.

# Supabase API URL (required). The local default is set up in Story 1.3.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase anon (public) key (required).
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Supabase service role key (optional, server only, never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=
# Sentry DSN (optional).
NEXT_PUBLIC_SENTRY_DSN=
# Sentry auth token (optional, build time only).
SENTRY_AUTH_TOKEN=
# Log level: debug | info | warn | error (optional; default info in production, debug otherwise).
NEXT_PUBLIC_LOG_LEVEL=
