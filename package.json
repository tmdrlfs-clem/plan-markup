{
  "name": "plan-markup",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start -p 3020",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:pinned": "node scripts/check-pinned.mjs",
    "check:env-files": "node scripts/check-env-files.mjs",
    "db:start": "node scripts/pin-postgres-image.mjs && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "node scripts/pin-postgres-image.mjs && supabase db reset",
    "db:test": "supabase test db",
    "db:types": "node scripts/generate-types.mjs",
    "db:schema": "supabase db dump --local --schema public,app -f supabase/schema.sql",
    "check:rls": "node scripts/check-rls.mjs",
    "check:schema": "node scripts/check-schema-drift.mjs",
    "check:types": "node scripts/check-types-drift.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@sentry/nextjs": "11.8.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "flatbush": "4.6.2",
    "idb": "8.0.4",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "1.8.1",
    "rbush": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "pg": "8.23.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
